{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Disable kubernetes manager for runner sidecar (version managed via kustomize images transformer)",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "n8nio/runners"
      ],
      "pinDigests": false,
      "enabled": false
    },
    {
      "description": "Use semver for n8n docker images to ignore pre-release tags (beta, nightly, etc)",
      "matchPackageNames": [
        "n8nio/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "semver"
    },
    {
      "description": "Coder: ignore pre-release versions (default versioning delay handles maturity)",
      "matchPackageNames": [
        "coder"
      ],
      "matchDatasources": [
        "helm"
      ],
      "ignoreUnstable": true
    },
    {
      "description": "Disable dockerfile manager for golang (ARG interpolation breaks updates; custom.regex manager handles these via annotations)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Hold Go on the 1.26 line: CodeQL CLI caps maxGoVersion at 1.26 and MegaLinter ships golangci-lint built with go1.26, so a 1.27 go directive breaks both required checks. Remove once CodeQL CLI >= 2.27.0 and MegaLinter ships golangci-lint >= 2.13.0. Ref #2575",
      "matchDatasources": [
        "golang-version",
        "docker"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "allowedVersions": "<1.27.0"
    }
  ]
}
