{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Annotated CNPG Database extension version pin (datasource first)."
      ],
      "managerFilePatterns": [
        "/(^|/)cluster/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+extractVersion=(?<extractVersion>\\S+)\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Disable kubernetes manager for runner sidecar (version managed via kustomize images transformer)",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "n8nio/runners"
      ],
      "pinDigests": false,
      "enabled": false
    },
    {
      "description": "Point own image changelogs at their release-please package directory",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/agent-queue-worker"
      ],
      "sourceDirectory": "ts/agent-queue-worker"
    },
    {
      "description": "Point own image changelogs at their release-please package directory. Ref #2684",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/bull-board"
      ],
      "sourceDirectory": "ts/agent-queue-worker/bull-board"
    },
    {
      "description": "Point own image changelogs at their release-please package directory. Ref #2684",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/mcp-header-proxy"
      ],
      "sourceDirectory": "cmd/mcp-header-proxy"
    },
    {
      "description": "Point own image changelogs at their release-please package directory. Ref #2684",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/shutdown-orchestrator"
      ],
      "sourceDirectory": "cmd/shutdown-orchestrator"
    },
    {
      "description": "Point own image changelogs at their release-please package directory. Ref #2684",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/kata-tap-qdisc-fix"
      ],
      "sourceDirectory": "cmd/kata-tap-qdisc-fix"
    },
    {
      "description": "The VPA bootstrap CRD seed must not get ahead of the chart appVersion",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "kubernetes/autoscaler"
      ],
      "dependencyDashboardApproval": true
    },
    {
      // The Talos extra-manifest URL and the Flux GitRepository tag pin the same
      // upstream release through different managers. Split PRs would let the CRDs
      // Talos applies drift from the ones Flux reconciles. Ref #2778
      "description": "Bump the Gateway API extra manifest and the Flux GitRepository tag in one PR; CRDs follow Cilium's supported version, so bumps need review",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/gateway-api"
      ],
      // Do not add a group.branchTopic carrying newVersion: the regex manager
      // renders 1.6.2 while the Flux manager renders v1.6.2, which would split
      // the group back into two PRs.
      "groupName": "gateway-api",
      "dependencyDashboardApproval": true
    },
    {
      // Coder tagged v2.36.6 and marked it Latest, but the chart is absent from
      // helm.coder.com/v2 index.yaml (the tarball exists; the index was
      // regenerated after the tag and still omits it), so Flux cannot resolve
      // it. Drop the skip once upstream re-indexes or a later stable release
      // lands. node-semver has no "!=" operator — an exclusion must be written
      // as a two-sided range. Ref #2997
      "description": "Skip coder 2.36.6 — GitHub release exists but the chart is missing from the Helm index",
      "matchDatasources": [
        "custom.coder-stable"
      ],
      "matchPackageNames": [
        "coder"
      ],
      "allowedVersions": "<2.36.6 || >2.36.6"
    },
    {
      "description": "Bump the pgvector extension image and the CNPG Database version pin in one PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/pgvector"
      ],
      "groupName": "pgvector"
    },
    {
      // Helm values use the short name, the Kyverno policy the fully-qualified
      // one; Renovate splits one digest bump into two PRs. Ref #3076
      "description": "Bump busybox in one PR regardless of how the image is referenced",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "busybox",
        "docker.io/library/busybox"
      ],
      "groupName": "busybox"
    }
  ]
}
