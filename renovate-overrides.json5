{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    // Echoes currentValue with an empty digest: custom datasources return null from
    // getDigest, so without it every PR warns "Could not determine new digest".
    "litellm-middleware-tested": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/anthony-spruyt/litellm-middleware/main/litellm-image.yaml",
      "format": "yaml",
      "transformTemplates": [
        "( $m := $match(image, /^ghcr\\.io\\/berriai\\/litellm-non_root:([^@\\s]+)@(sha256:[a-f0-9]{64})$/); $tested := { \"version\": $m.groups[0], \"digest\": $m.groups[1] }; { \"releases\": $m.groups[0] = \"{{{currentValue}}}\" ? [$tested] : [$tested, { \"version\": \"{{{currentValue}}}\", \"digest\": \"\" }], \"sourceUrl\": \"https://github.com/BerriAI/litellm\" } )"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Annotated CNPG Database extension version pin (datasource first)."
      ],
      "managerFilePatterns": [
        "/(^|/)cluster/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+extractVersion=(?<extractVersion>\\S+)\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": [
        "Annotated Terraform version string (datasource first). Ref #3305"
      ],
      "managerFilePatterns": [
        "/(^|/)cluster/.+\\.tf$/"
      ],
      // currentValue excludes ":" so image refs stay with the repo-operator Terraform Docker managers.
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"/:@\\s]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "LiteLLM follows the middleware repo's tested pin, never the registry. Ref #3272",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/berriai/litellm-non_root"
      ],
      "enabled": false
    },
    {
      // No release timestamps here, so the default 7-day age would hold every update
      // forever; the middleware repo's bump PR already waited it out.
      "description": "Take the middleware-tested LiteLLM as soon as it lands on the middleware repo's main. Ref #3272",
      "matchDatasources": [
        "custom.litellm-middleware-tested"
      ],
      "minimumReleaseAge": "0 days",
      "commitMessageTopic": "container image {{depName}}",
      "addLabels": [
        "renovate/image"
      ]
    },
    {
      "description": "Disable kubernetes manager for runner sidecar (version managed via kustomize images transformer)",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "n8nio/runners"
      ],
      "pinDigests": false,
      "enabled": false
    },
    {
      // 2.39.x lacks the worker MCP toolkit fix (upstream #38069) that 2.38.7 backports and 2.40.0 ships.
      // Drop once the pin is on 2.40.x. Ref #3075
      "description": "Skip the n8n 2.39.x line (missing worker MCP toolkit fix)",
      "matchDatasources": [
        "custom.n8n-stable"
      ],
      "allowedVersions": "!/^2\\.39\\./"
    },
    {
      "description": "Fetch mcp-header-proxy release notes from its own repo. Ref #3274",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/mcp-header-proxy"
      ],
      "sourceUrl": "https://github.com/anthony-spruyt/mcp-header-proxy"
    },
    {
      "description": "Point own image changelogs at their release-please package directory. Ref #2684",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/shutdown-orchestrator"
      ],
      "sourceDirectory": "cmd/shutdown-orchestrator"
    },
    {
      "description": "Fetch kata-tap-qdisc-fix release notes from its own repo. Ref #3273",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/anthony-spruyt/kata-tap-qdisc-fix"
      ],
      "sourceUrl": "https://github.com/anthony-spruyt/kata-tap-qdisc-fix"
    },
    {
      "description": "The VPA bootstrap CRD seed must not get ahead of the chart appVersion",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "kubernetes/autoscaler"
      ],
      "dependencyDashboardApproval": true
    },
    {
      // Talos and Flux pin the same Gateway API release through different managers; split PRs let their CRDs drift. Ref #2778
      "description": "Bump the Gateway API extra manifest and the Flux GitRepository tag in one PR; CRDs follow Cilium's supported version, so bumps need review",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/gateway-api"
      ],
      // No group.branchTopic with newVersion: the regex manager renders 1.6.2 and Flux v1.6.2, splitting the group.
      "groupName": "gateway-api",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Bump the pgvector extension image and the CNPG Database version pin in one PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/pgvector"
      ],
      "groupName": "pgvector"
    },
    {
      // Grouping only coalesces updates pending at once; it does not enforce velero's compatibility matrix. Ref #3081
      "description": "Bump the velero server image, CLI installer pin and AWS plugin in one PR",
      "matchPackageNames": [
        "docker.io/velero/velero",
        "vmware-tanzu/velero",
        "velero/velero-plugin-for-aws"
      ],
      "groupName": "velero"
    },
    {
      // Helm values use the short name, the Kyverno policy the fully-qualified
      // one; Renovate splits one digest bump into two PRs. Ref #3076
      "description": "Bump busybox in one PR regardless of how the image is referenced",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "busybox",
        "docker.io/library/busybox"
      ],
      "groupName": "busybox"
    },
    {
      // litellm-middleware#14 releases a compat fix before moving the pin; if that bump is still open, the LiteLLM one joins it. Ref #3399
      "description": "Bump LiteLLM and the litellm-middleware image in one PR",
      "matchDatasources": [
        "custom.litellm-middleware-tested",
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/berriai/litellm-non_root",
        "ghcr.io/anthony-spruyt/litellm-middleware"
      ],
      "groupName": "litellm",
      "separateMajorMinor": false
    }
  ]
}
